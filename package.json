{
  "name": "@sand/cli",
  "version": "0.1.0",
  "description": "Run coding-agent sessions in Azure Container Apps Sandboxes",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nquandt/omp-azure-sandboxes.git"
  },
  "bugs": {
    "url": "https://github.com/nquandt/omp-azure-sandboxes/issues"
  },
  "homepage": "https://github.com/nquandt/omp-azure-sandboxes#readme",
  "type": "module",
  "bin": {
    "sand": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build src/main.ts --compile --outfile dist/sand"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "typescript": "^5.9.3"
  }
}
